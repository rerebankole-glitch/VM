{
    "name": "browser-vm",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "A real browser computer with desktop mode, streaming-only 32-bit images, focused input and optional local snapshots. Static v86 app, with an optional diskless image relay.",
    "keywords": [
        "v86",
        "emulator",
        "virtual-machine",
        "x86",
        "linux",
        "mx-linux",
        "lubuntu",
        "linux-mint",
        "github-pages"
    ],
    "license": "MIT",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "start": "node tools/serve.mjs",
        "serve": "node tools/serve.mjs",
        "test": "node --test tests/*.test.mjs",
        "vendor": "bash tools/vendor-v86.sh && bash tools/fetch-demo-images.sh",
        "vendor:v86": "bash tools/vendor-v86.sh",
        "vendor:v86_64": "bash tools/vendor-v86_64.sh",
        "vendor:images": "bash tools/fetch-demo-images.sh",
        "test:browser": "node tools/browser-smoke.mjs"
    }
}
